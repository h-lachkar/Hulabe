# Database (Supabase Postgres)
DATABASE_URL="postgresql://postgres.xxxxxx:password@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxx:password@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# Resend (transactional emails)
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="Hulabe <support@hulabe.com>"
NOTIFICATION_EMAIL="support@hulabe.com"

# Public
NEXT_PUBLIC_SITE_URL="https://hulabe.com"

# PostHog (analytics + session replay)
NEXT_PUBLIC_POSTHOG_KEY="phc_xxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# Supabase Auth (admin + client portal)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIs..."
# SERVICE ROLE key — needed to generate magic links from /admin (invite clients).
# NEVER expose this client-side. It's only read by server actions.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIs..."

# Admin access is managed via the AdminUser table in the database.
# Seed the first OWNER manually via SQL — see SETUP.md §4.

# Client portal subdomain (used by next.config.mjs rewrite and email links)
NEXT_PUBLIC_CLIENT_HOST="client.hulabe.com"
NEXT_PUBLIC_CLIENT_URL="https://client.hulabe.com"

# Anthropic — AI lead scoring (optional, no key = no scoring)
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
