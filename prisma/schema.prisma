generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lead {
  id                String       @id @default(cuid())
  email             String
  name              String?
  phone             String?
  source            LeadSource
  serviceType       ServiceType?
  budget            String?
  timeline          String?
  message           String?      @db.Text
  features          String[]     @default([])
  estimatedPriceMin Int?
  estimatedPriceMax Int?
  locale            String
  status            LeadStatus   @default(NEW)
  ipHash            String?

  // --- AI lead scoring (filled async after create) ---
  aiScore            Int?     // 1-10 deal probability
  aiReasoning        String?  @db.Text
  aiSuggestedReply   String?  @db.Text
  aiNextAction       AiNextAction?
  aiFlags            String[]      @default([])
  aiModel            String?  // e.g. "claude-haiku-4-5"
  aiScoredAt         DateTime?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  notes      Note[]
  activities Activity[]
  projects   Project[]

  @@index([createdAt])
  @@index([status])
  @@index([email])
}

model Project {
  id          String        @id @default(cuid())
  leadId      String?
  lead        Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  name        String
  serviceType ServiceType?
  status      ProjectStatus @default(DRAFT)

  // pricing in cents to avoid float issues
  priceQuotedCents Int?
  priceFinalCents  Int?

  startedAt DateTime?
  shippedAt DateTime?

  /// Random opaque token for client-portal magic-link access.
  /// Clients reach the portal via a link that includes this token; the API
  /// then issues a Supabase magic-link to lead.email after verification.
  clientPortalToken String? @unique

  /// Inclusive support window end. Default = shippedAt + 14 days when shipped.
  supportEndsAt DateTime?

  notes           Note[]
  activities      Activity[]
  invoices        Invoice[]
  deliverables    Deliverable[]
  supportRequests SupportRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([leadId])
  @@index([createdAt])
}

model Note {
  id          String   @id @default(cuid())
  body        String   @db.Text
  authorId    String?
  authorEmail String?
  /// If true, this note is also visible in the client portal.
  /// Default false = internal admin-only.
  visibleToClient Boolean @default(false)

  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([projectId])
  @@index([createdAt])
}

/// Project deliverables exposed in the client portal
/// (links to repos, deployment URLs, design files, docs, screenshots).
model Deliverable {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        DeliverableKind @default(LINK)
  title       String
  description String?  @db.Text
  url         String?
  fileKey     String?  // future: S3/Supabase Storage object key
  visibleToClient Boolean @default(true)
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

/// Client-initiated support / change requests (used during the 14-day window
/// included in every project, or via a paid maintenance contract).
model SupportRequest {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  body        String   @db.Text
  status      SupportRequestStatus @default(OPEN)
  createdById String?  // Supabase user UUID (admin or client)
  createdByEmail String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

model Activity {
  id          String       @id @default(cuid())
  kind        ActivityKind
  summary     String
  metadata    Json?
  authorId    String?
  authorEmail String?

  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([projectId])
  @@index([createdAt])
}

model Invoice {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    String        @unique
  status    InvoiceStatus @default(DRAFT)
  amountCents Int
  issuedAt  DateTime?
  paidAt    DateTime?
  dueAt     DateTime?
  notes     String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([projectId])
  @@index([status])
}

enum LeadSource {
  CONTACT_FORM
  SIMULATOR
}

enum ServiceType {
  VITRINE
  ECOMMERCE
  SHOPIFY
  LOVABLE_TO_APP
  SAAS_MVP
  MOBILE_APP
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum ProjectStatus {
  DRAFT
  QUOTED
  SIGNED
  IN_PROGRESS
  IN_REVIEW
  SHIPPED
  ARCHIVED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum ActivityKind {
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  LEAD_NOTE_ADDED
  PROJECT_CREATED
  PROJECT_STATUS_CHANGED
  PROJECT_NOTE_ADDED
  INVOICE_CREATED
  INVOICE_STATUS_CHANGED
  DELIVERABLE_ADDED
  SUPPORT_REQUEST_OPENED
  SUPPORT_REQUEST_RESOLVED
}

enum DeliverableKind {
  LINK
  REPO
  DEPLOYMENT
  DESIGN
  DOC
  FILE
}

enum SupportRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AiNextAction {
  SEND_QUOTE
  BOOK_CALL
  ASK_CLARIFICATION
  DECLINE_POLITELY
}

/// Admin users who can access /admin. Authentication is done via Supabase
/// magic-link, but the source of truth for "who is admin" is THIS table —
/// not an env var. The first OWNER is seeded manually via SQL (see SETUP.md).
model AdminUser {
  id          String     @id @default(cuid())
  email       String     @unique
  name        String?
  role        AdminRole  @default(ADMIN)
  isActive    Boolean    @default(true)
  /// AdminUser.id of the admin who created this account (null = seeded manually).
  invitedById String?
  invitedBy   AdminUser? @relation("AdminInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees    AdminUser[] @relation("AdminInvites")
  /// When the magic-link invitation was sent.
  invitedAt   DateTime?
  /// Set when the user successfully sets their password for the first time
  /// (either via initial invite or forgot-password flow).
  passwordSetAt DateTime?
  /// Set on every successful login.
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive])
  @@index([role])
}

enum AdminRole {
  OWNER
  ADMIN
  VIEWER
}
