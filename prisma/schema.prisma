generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lead {
  id                String       @id @default(cuid())
  email             String
  name              String?
  phone             String?
  source            LeadSource
  serviceType       ServiceType?
  budget            String?
  timeline          String?
  message           String?      @db.Text
  features          String[]     @default([])
  estimatedPriceMin Int?
  estimatedPriceMax Int?
  locale            String
  status            LeadStatus   @default(NEW)
  ipHash            String?

  // --- AI lead scoring (filled async after create) ---
  aiScore            Int?     // 1-10 deal probability
  aiReasoning        String?  @db.Text
  aiSuggestedReply   String?  @db.Text
  aiNextAction       AiNextAction?
  aiFlags            String[]      @default([])
  aiModel            String?  // e.g. "claude-haiku-4-5"
  aiScoredAt         DateTime?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  notes      Note[]
  activities Activity[]
  projects   Project[]

  @@index([createdAt])
  @@index([status])
  @@index([email])
}

model Project {
  id          String        @id @default(cuid())
  leadId      String?
  lead        Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  name        String
  serviceType ServiceType?
  status      ProjectStatus @default(DRAFT)

  // pricing in cents to avoid float issues
  priceQuotedCents Int?
  priceFinalCents  Int?

  startedAt DateTime?
  shippedAt DateTime?

  /// Random opaque token for client-portal magic-link access.
  /// Clients reach the portal via a link that includes this token; the API
  /// then issues a Supabase magic-link to lead.email after verification.
  clientPortalToken String? @unique

  /// Inclusive support window end. Default = shippedAt + 14 days when shipped.
  supportEndsAt DateTime?

  notes           Note[]
  activities      Activity[]
  invoices        Invoice[]
  deliverables    Deliverable[]
  supportRequests SupportRequest[]

  /// Unified project membership.
  /// A member can be either an internal admin assigned to the project (used
  /// when their `accessScope = ASSIGNED` to scope what they see) or a client
  /// who can view this project in the client portal.
  members         ProjectMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([leadId])
  @@index([createdAt])
}

/// Project ↔ User join table. Replaces the older Admin-only and Client-only
/// join tables. The role of the member is determined by `user.role`:
///   - CLIENT user → has portal access to this project
///   - ADMIN/VIEWER user → scoped admin assignment (used when accessScope=ASSIGNED)
///   - OWNER user → assignment is ignored (OWNERs always see everything)
model ProjectMember {
  projectId String
  userId    String
  addedAt   DateTime @default(now())
  /// User.id of the admin who created the link (null = legacy / seeded).
  addedById String?
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Note {
  id          String   @id @default(cuid())
  body        String   @db.Text
  authorId    String?
  authorEmail String?
  /// If true, this note is also visible in the client portal.
  /// Default false = internal admin-only.
  visibleToClient Boolean @default(false)

  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([projectId])
  @@index([createdAt])
}

/// Project deliverables exposed in the client portal.
/// A deliverable can be a TEXT note, a LINK, a file (FILE) uploaded to
/// Supabase Storage, or a categorized link (REPO/DEPLOYMENT/DESIGN/DOC).
model Deliverable {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        DeliverableKind @default(LINK)
  title       String
  description String?  @db.Text
  url         String?

  // File metadata (when kind = FILE)
  fileKey      String?  // Supabase Storage object key, relative to "deliverables" bucket
  fileName     String?  // Original filename for display
  fileSize     Int?     // Bytes
  fileContentType String?

  visibleToClient Boolean @default(true)
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

/// Client-initiated support / change requests (used during the 14-day window
/// included in every project, or via a paid maintenance contract).
model SupportRequest {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  body        String   @db.Text
  status      SupportRequestStatus @default(OPEN)
  createdById String?  // Supabase user UUID (admin or client)
  createdByEmail String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

model Activity {
  id          String       @id @default(cuid())
  kind        ActivityKind
  summary     String
  metadata    Json?
  authorId    String?
  authorEmail String?

  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([projectId])
  @@index([createdAt])
}

model Invoice {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    String        @unique
  status    InvoiceStatus @default(DRAFT)

  // Amounts in cents to avoid float issues
  subtotalCents Int  @default(0)
  taxRate       Int  @default(0)  // basis points (2000 = 20.00%)
  taxCents      Int  @default(0)
  amountCents   Int                // grand total = subtotal + tax

  currency  String       @default("EUR")

  // Billing info (snapshot at issue time so future client edits don't mutate
  // historical invoices)
  clientName    String?
  clientEmail   String?
  clientAddress String?  @db.Text
  clientVatNumber String?

  issuedAt  DateTime?
  paidAt    DateTime?
  dueAt     DateTime?
  notes     String?       @db.Text

  lines     InvoiceLine[]

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([issuedAt])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String   @db.Text
  quantity    Float    @default(1)
  unitPriceCents Int
  /// Computed at write time (quantity * unitPriceCents). Stored to make
  /// reads & PDF generation deterministic.
  totalCents  Int
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

/// Counter used to mint the next invoice number per fiscal year.
/// Invoice number format: YYYY-NNNN (e.g. 2026-0001, 2026-0002…)
model InvoiceCounter {
  year     Int  @id
  current  Int  @default(0)
  updatedAt DateTime @updatedAt
}

enum LeadSource {
  CONTACT_FORM
  SIMULATOR
}

enum ServiceType {
  VITRINE
  ECOMMERCE
  SHOPIFY
  LOVABLE_TO_APP
  SAAS_MVP
  MOBILE_APP
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum ProjectStatus {
  DRAFT
  QUOTED
  SIGNED
  IN_PROGRESS
  IN_REVIEW
  SHIPPED
  ARCHIVED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum ActivityKind {
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  LEAD_NOTE_ADDED
  PROJECT_CREATED
  PROJECT_STATUS_CHANGED
  PROJECT_NOTE_ADDED
  INVOICE_CREATED
  INVOICE_STATUS_CHANGED
  DELIVERABLE_ADDED
  SUPPORT_REQUEST_OPENED
  SUPPORT_REQUEST_RESOLVED
}

enum DeliverableKind {
  TEXT
  LINK
  REPO
  DEPLOYMENT
  DESIGN
  DOC
  FILE
}

enum SupportRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AiNextAction {
  SEND_QUOTE
  BOOK_CALL
  ASK_CLARIFICATION
  DECLINE_POLITELY
}

/// Unified user table for both internal team members (OWNER / ADMIN / VIEWER)
/// AND client portal users (CLIENT). Authentication is done via Supabase
/// magic-link / password, but the source of truth for who exists and what
/// they can do is THIS table.
///
/// The first OWNER is seeded manually via SQL (see SETUP.md).
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  role        UserRole @default(CLIENT)
  isActive    Boolean  @default(true)

  /// Admin-only: whether this user sees every project (ALL, default) or only
  /// the ones explicitly assigned via ProjectMember (ASSIGNED). Ignored for
  /// CLIENT users (they always need an explicit ProjectMember). OWNER always
  /// sees all regardless of this flag.
  accessScope AdminScope @default(ALL)

  /// Client-only metadata (nullable; ignored for non-CLIENT roles)
  company     String?
  phone       String?
  notes       String?  @db.Text  // internal admin notes about this user

  /// User.id of the user who invited this account (null = seeded manually).
  invitedById String?
  invitedBy   User?    @relation("UserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees    User[]   @relation("UserInvites")

  /// Projects this user is a member of (admin assignment OR client access).
  projects    ProjectMember[]

  /// When the magic-link invitation was sent.
  invitedAt   DateTime?
  /// Set when the user successfully sets their password for the first time
  /// (either via initial invite or forgot-password flow).
  passwordSetAt DateTime?
  /// Set on every successful login.
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([role])
}

enum UserRole {
  OWNER
  ADMIN
  VIEWER
  CLIENT
}

enum AdminScope {
  ALL
  ASSIGNED
}
